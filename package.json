{
  "name": "beadside",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/thatmike1/beadside",
  "type": "module",
  "bin": {
    "beadside": "./bin/beadside.mjs",
    "bd-board": "./bin/bd-board.mjs"
  },
  "scripts": {
    "dev": "concurrently -n server,ui -c blue,magenta \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch server/main.ts --port 1338 --no-open",
    "dev:ui": "vite --config ui/vite.config.ts",
    "mock": "tsx scripts/mock-api.mjs",
    "build": "vite build --config ui/vite.config.ts",
    "start": "tsx server/main.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.102.8",
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
